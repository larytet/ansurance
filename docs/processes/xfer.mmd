  start(["Agent transfer (appointment letter)"]):::end1
  s_sign["<b>1. Sign the appointment</b><br/>Role: Agent<br/>☐ Continuing authorization (appendix B1) signed<br/>☐ Client told about the effect on the old agent"]:::agent
