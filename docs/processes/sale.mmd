  start(["Quote, sale and policy issuance"]):::end1
  s_need["<b>1. Needs and suitability</b><br/>Role: Agent<br/>☐ Client needs recorded<br/>☐ At least two alternatives compared<br/>☐ Existing cover checked (duplicate or replacement)<br/>☐ Reasoning document drafted"]:::agent
