# Copy to .env and set real values. Never commit .env.
POSTGRES_PASSWORD=change-me
# Address the proxy listens on. Use the VPN interface address, never a public one.
BIND_ADDR=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
ANS_PROFILE=onprem
OBJECTSTORE_PASSWORD=change-me-too
OBJECTSTORE_APP_PASSWORD=change-me-three
# Encrypts every backup. Keep a copy outside this host: without it backups cannot be read.
BACKUP_PASSPHRASE=change-me-four
# Directory on a different disk for the backups (default: a Docker volume on this host)
# BACKUP_PATH=/mnt/backup-disk/ansurance
# Where the archived write-ahead log goes (also on a different disk; part of the backups)
# BACKUP_WAL_PATH=/mnt/backup-disk/ansurance-wal
# Minimum password length for local accounts (default and floor: 8)
# ANS_PASSWORD_MIN_LENGTH=8
# SSO providers (JSON list, one line). See README, "Add an SSO user (Google)".
# ANS_SSO_PROVIDERS=[]
