# Encryption key, database, and the object store (S3). Everything is encrypted at rest.

resource "aws_kms_key" "main" {
  description             = "${local.name} data encryption"
  enable_key_rotation     = true
  deletion_window_in_days = 30

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "AccountAdministration"
        Effect    = "Allow"
        Principal = { AWS = "arn:aws:iam::${var.account_id}:root" }
        Action    = "kms:*"
        Resource  = "*"
      },
      {
        Sid       = "LogsAndAlarms"
        Effect    = "Allow"
        Principal = { Service = ["logs.${var.region}.amazonaws.com", "cloudwatch.amazonaws.com", "cloudtrail.amazonaws.com", "config.amazonaws.com", "backup.amazonaws.com"] }
        Action    = ["kms:Encrypt", "kms:Decrypt", "kms:ReEncrypt*", "kms:GenerateDataKey*", "kms:DescribeKey"]
        Resource  = "*"
      }
    ]
  })
}

resource "aws_kms_alias" "main" {
  name          = "alias/${local.name}"
  target_key_id = aws_kms_key.main.key_id
}

# --- PostgreSQL ---------------------------------------------------------------------------
resource "aws_db_subnet_group" "main" {
  name       = local.name
  subnet_ids = aws_subnet.data[*].id
}

resource "aws_db_parameter_group" "main" {
  name   = "${local.name}-pg16"
  family = "postgres16"

  parameter {
    name  = "rds.force_ssl"
    value = "1"
  }
  parameter {
    name  = "log_connections"
    value = "1"
  }
  parameter {
    name  = "log_disconnections"
    value = "1"
  }
}

resource "aws_db_instance" "main" {
  identifier     = local.name
  engine         = "postgres"
  engine_version = "16"
  instance_class = var.rds_instance_class

  allocated_storage = var.rds_allocated_storage
  storage_type      = "gp3"
  storage_encrypted = true
  kms_key_id        = aws_kms_key.main.arn

  db_name  = "ansurance"
  username = "ansurance"
  # The password is generated by RDS and kept in Secrets Manager; nobody types or stores it.
  manage_master_user_password   = true
  master_user_secret_kms_key_id = aws_kms_key.main.arn

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.db.id]
  parameter_group_name   = aws_db_parameter_group.main.name
  publicly_accessible    = false
  multi_az               = var.rds_multi_az

  backup_retention_period             = var.backup_retention_days
  backup_window                       = "01:00-02:00"
  maintenance_window                  = "Fri:23:00-Sat:00:00"
  copy_tags_to_snapshot               = true
  deletion_protection                 = var.deletion_protection
  skip_final_snapshot                 = !var.deletion_protection
  final_snapshot_identifier           = var.deletion_protection ? "${local.name}-final" : null
  auto_minor_version_upgrade          = true
  apply_immediately                   = var.environment != "prod"
  iam_database_authentication_enabled = true

  performance_insights_enabled    = true
  performance_insights_kms_key_id = aws_kms_key.main.arn
  enabled_cloudwatch_logs_exports = ["postgresql", "upgrade"]
}

# --- object store -------------------------------------------------------------------------
locals {
  # kms = false only for the load balancer access logs (ALB supports SSE-S3 only)
  buckets = {
    originals     = { kms = true, lock = true }
    derived       = { kms = true, lock = false }
    exports       = { kms = true, lock = false }
    audit_archive = { kms = true, lock = true }
    trail         = { kms = true, lock = false }
    config        = { kms = true, lock = false }
    alb_logs      = { kms = false, lock = false }
  }
}

locals {
  # Names and ARNs are derived from variables, not from resource attributes, so the policy
  # documents below are fully known at plan time (and can be checked by the tests).
  bucket_names = { for k, v in local.buckets : k => "${local.name}-${replace(k, "_", "-")}-${var.account_id}" }
  bucket_arns  = { for k, v in local.bucket_names : k => "arn:aws:s3:::${v}" }
}

resource "aws_s3_bucket" "b" {
  for_each            = local.buckets
  bucket              = local.bucket_names[each.key]
  object_lock_enabled = each.value.lock
}

resource "aws_s3_bucket_public_access_block" "b" {
  for_each                = local.buckets
  bucket                  = aws_s3_bucket.b[each.key].id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_ownership_controls" "b" {
  for_each = local.buckets
  bucket   = aws_s3_bucket.b[each.key].id
  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

resource "aws_s3_bucket_versioning" "b" {
  for_each = local.buckets
  bucket   = aws_s3_bucket.b[each.key].id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "b" {
  for_each = local.buckets
  bucket   = aws_s3_bucket.b[each.key].id
  rule {
    bucket_key_enabled = each.value.kms
    apply_server_side_encryption_by_default {
      sse_algorithm     = each.value.kms ? "aws:kms" : "AES256"
      kms_master_key_id = each.value.kms ? aws_kms_key.main.arn : null
    }
  }
}

# Originals and the audit archive are write-once: Object Lock with a default retention.
resource "aws_s3_bucket_object_lock_configuration" "b" {
  for_each = { for k, v in local.buckets : k => v if v.lock }
  bucket   = aws_s3_bucket.b[each.key].id
  rule {
    default_retention {
      mode = "GOVERNANCE"
      days = var.originals_lock_days
    }
  }
  depends_on = [aws_s3_bucket_versioning.b]
}

# Derived artifacts and exports can be rebuilt, so old versions expire.
resource "aws_s3_bucket_lifecycle_configuration" "rebuildable" {
  for_each = { for k, v in local.buckets : k => v if contains(["derived", "exports"], k) }
  bucket   = aws_s3_bucket.b[each.key].id

  rule {
    id     = "expire-old-versions"
    status = "Enabled"
    filter {}
    noncurrent_version_expiration {
      noncurrent_days = 30
    }
    abort_incomplete_multipart_upload {
      days_after_initiation = 7
    }
  }
}

locals {
  # Extra bucket-policy statements for the AWS services that write into their own bucket.
  extra_bucket_statements = {
    trail = [
      {
        Sid       = "CloudTrailAclCheck"
        Effect    = "Allow"
        Principal = { Service = "cloudtrail.amazonaws.com" }
        Action    = "s3:GetBucketAcl"
        Resource  = local.bucket_arns["trail"]
      },
      {
        Sid       = "CloudTrailWrite"
        Effect    = "Allow"
        Principal = { Service = "cloudtrail.amazonaws.com" }
        Action    = "s3:PutObject"
        Resource  = "${local.bucket_arns["trail"]}/AWSLogs/${var.account_id}/*"
        Condition = { StringEquals = { "s3:x-amz-acl" = "bucket-owner-full-control" } }
      },
    ]
    config = [
      {
        Sid       = "ConfigAclCheck"
        Effect    = "Allow"
        Principal = { Service = "config.amazonaws.com" }
        Action    = ["s3:GetBucketAcl", "s3:ListBucket"]
        Resource  = local.bucket_arns["config"]
      },
      {
        Sid       = "ConfigWrite"
        Effect    = "Allow"
        Principal = { Service = "config.amazonaws.com" }
        Action    = "s3:PutObject"
        Resource  = "${local.bucket_arns["config"]}/AWSLogs/${var.account_id}/Config/*"
        Condition = { StringEquals = { "s3:x-amz-acl" = "bucket-owner-full-control" } }
      },
    ]
    alb_logs = [
      {
        Sid       = "AlbLogDelivery"
        Effect    = "Allow"
        Principal = { Service = "logdelivery.elasticloadbalancing.amazonaws.com" }
        Action    = "s3:PutObject"
        Resource  = "${local.bucket_arns["alb_logs"]}/alb/AWSLogs/${var.account_id}/*"
      },
    ]
  }
}

resource "aws_s3_bucket_policy" "b" {
  for_each = local.buckets
  bucket   = aws_s3_bucket.b[each.key].id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = concat(
      [{
        Sid       = "DenyInsecureTransport"
        Effect    = "Deny"
        Principal = "*"
        Action    = "s3:*"
        Resource  = [local.bucket_arns[each.key], "${local.bucket_arns[each.key]}/*"]
        Condition = { Bool = { "aws:SecureTransport" = "false" } }
      }],
      try(local.extra_bucket_statements[each.key], [])
    )
  })
  depends_on = [aws_s3_bucket_public_access_block.b]
}
